# ---------------------------------------------------------------------------
# Hayy — environment variable reference
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
#
# Production domain: hayy.ca
#
# Before going live, also configure the following in the Supabase dashboard
# (these cannot be set via environment variables — they must be set manually):
#
#   Authentication → URL Configuration:
#     Site URL:              https://hayy.ca
#     Redirect URLs:         https://hayy.ca/auth/confirm
#                            https://hayy.ca/**          (wildcard for previews)
#
#   Authentication → Providers → Email:
#     Confirm email:         enabled
#     Secure email change:   enabled
#
#   Authentication → Email Templates:
#     Confirm signup URL:    https://hayy.ca/auth/confirm
#     Magic link URL:        https://hayy.ca/auth/confirm
#     Change email URL:      https://hayy.ca/auth/confirm
#
#   API → CORS Allowed Origins:
#     https://hayy.ca
#     https://*.vercel.app   (optional, for preview deployments)
#
#   Also update VITE_LIVEKIT_URL below to your LiveKit Cloud wss:// endpoint.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase — frontend (Vite exposes VITE_ vars to the browser bundle)
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# LiveKit — frontend (Vite exposes this; the wss:// URL is safe to be public)
# ---------------------------------------------------------------------------
VITE_LIVEKIT_URL=

# ---------------------------------------------------------------------------
# Supabase — server-only (Vercel serverless functions; no VITE_ prefix)
# These mirror the VITE_ values above but are set as server-only vars in
# Vercel so they are never baked into the browser bundle.
# ---------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# LiveKit — server-only (NEVER expose to browser or prefix with VITE_)
# Find these in your LiveKit Cloud project → Settings → Keys.
# ---------------------------------------------------------------------------
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ---------------------------------------------------------------------------
# Supabase service role — server-only (NEVER expose to browser or prefix with VITE_)
#
# Required by api/delete-account.ts to call auth.admin.deleteUser().
# The anon key cannot delete auth.users — only the service_role key can.
#
# Find this in: Supabase dashboard → Settings → API → service_role key
# (the one labelled "secret"). Treat it like a database root password —
# anyone holding it can read/write any row in your project, regardless
# of RLS.
# ---------------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=
